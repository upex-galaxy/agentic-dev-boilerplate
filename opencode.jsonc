{
  // OpenCode shared team config, committed to git.
  // Secrets are NEVER stored here. Every credential below is a {file:...} POINTER
  // to a gitignored value file under .auth/opencode/, which `bun run harness:env`
  // generates from .env (one file per variable, mode 0600, no trailing newline).
  // See .env.example for the variables themselves.
  //
  // WHY {file:} AND NOT {env:}. {env:VAR} resolves from the OpenCode PROCESS
  // environment, which a desktop / GUI launch or a natively-launched supervised
  // worker does not have: the MCP servers would start with empty credentials.
  // {file:path} substitutes the file's CONTENTS and needs no environment at all.
  //
  // Two behaviours to know before editing this file:
  //   - a MISSING {file:} target invalidates the WHOLE config, not one server.
  //     `bun install` (the `prepare` script) creates an EMPTY placeholder for
  //     every reference below, so a fresh clone still loads; an empty file
  //     resolves to "" exactly as an unset {env:VAR} did.
  //   - {file:} paths are relative to THIS file's directory, so in a worktree
  //     they read the worktree's own .auth/opencode/ (`bun run worktree:provision`
  //     regenerates it from the copied .env).
  //   - OpenCode's background service caches the resolved config per directory,
  //     so a rewritten value file is not seen until it restarts
  //     (`opencode service restart`, or quit every OpenCode session).
  //
  // Syntax notes (OpenCode-specific, different from Claude Code's .mcp.json):
  //   - File substitution uses {file:path}, env expansion {env:VAR_NAME} (NOT ${VAR})
  //   - MCP root key is "mcp"                  (NOT "mcpServers")
  //   - MCP env field is "environment"         (NOT "env")
  //   - An empty value fails later, at the first authenticated call: AGENTS.md
  //     Critical Rule #9 (stop immediately when MCP credentials fail).
  "$schema": "https://opencode.ai/config.json",

  // Plugins:
  //   - `@warp-dot-dev/opencode-warp`: Warp terminal integration — surfaces
  //     OpenCode agent activity as native Warp notifications. Auto-installed
  //     when OpenCode runs inside Warp.
  //     Docs: https://docs.warp.dev/agent-platform/cli-agents/opencode/
  //   - `opencode-subagent-statusline`: renders an active-subagent statusline
  //     in the OpenCode TUI so multi-agent dispatch is visible at a glance.
  "plugin": ["@warp-dot-dev/opencode-warp", "opencode-subagent-statusline"],

  // Local (stdio) servers only. Web search runs at harness level (your user
  // config), never here: see .agents/skills/agentic-dev-core/references/mcp-capabilities.md.
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "supabase": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "{file:.auth/opencode/SUPABASE_ACCESS_TOKEN}",
      ],
      "enabled": true,
      "environment": {
        "SUPABASE_URL": "{file:.auth/opencode/NEXT_PUBLIC_SUPABASE_URL}",
        "SUPABASE_ANON_KEY": "{file:.auth/opencode/SUPABASE_PUBLISHABLE_KEY}",
        "SUPABASE_SERVICE_ROLE_KEY": "{file:.auth/opencode/SUPABASE_SECRET_KEY}",
      },
    },
    "n8n": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": true,
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "{file:.auth/opencode/N8N_API_URL}",
        "N8N_API_KEY": "{file:.auth/opencode/N8N_API_KEY}",
      },
    },
  },

  // Permissions — mirrors .claude/settings.json 1:1.
  // Rule precedence: last matching pattern wins, so deny entries are placed
  // AFTER the broad allows they override (e.g. `git *` allow, then
  // `git push --force *` deny — the deny wins for force-pushes).
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",

      "bun *": "allow",
      "bunx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "node *": "allow",

      "git *": "allow",
      "gh *": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tree *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "curl *": "allow",

      "acli *": "allow",
      "resend *": "allow",
      "supabase *": "allow",

      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "wget *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git branch -D *": "deny",
      "chmod 777 *": "deny",
      "truncate *": "deny",
      "shred *": "deny",
      "dd if=*": "deny",
      "mkfs*": "deny",
    },
  },
}
