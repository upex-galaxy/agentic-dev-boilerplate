{
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "supabase": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "SUPABASE_ACCESS_TOKEN",
        "--",
        "bunx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ]
    },
    "n8n": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "N8N_API_URL,N8N_API_KEY",
        "--",
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    }
  }
}
