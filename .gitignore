# ====================================
# UPEX Project Starter - .gitignore
# ====================================

# Dependencies
node_modules/

# ===== SDD / Framework Caches =====
# .atl/ holds sdd-init generated registry, regenerated on demand
.atl/
# Known underscore-prefixed caches. Listed explicitly because a blanket
# `*_*/` rule would also swallow skill subfolders like
# `.agents/skills/<skill>/references/_shared/`, which we DO want to commit
# (this repo is a boilerplate — skills must ship).
.husky/_/

# ===== Build Artifacts =====
dist/
build/
.next/
*.tsbuildinfo
next-env.d.ts

# ===== Playwright Test Artifacts =====
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# ===== Auth Storage (Session State) =====
/.auth/

# ===== Ephemeral session material (defence in depth) =====
# Per the ephemeral-artifact contract in
# .agents/skills/agentic-dev-core/references/orchestration-doctrine.md, session
# material NEVER lands in the repo tree — it belongs in the session scratch dir
# and is deleted before the subagent reports. These patterns exist so a slip
# cannot become a committed secret.
*storage-state*.json
*storageState*.json
*.cookies
cookies.txt
*.har

# ===== Allure Reports =====
/allure-results/
/allure-report/

# ===== Custom Reports =====
/reports/
*.json.bak

# ===== Debug Logs =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Environment =====
.env
.env.local
.env.*.local
.env.sentry-build-plugin
.envrc.local
.direnv/
# Force-track .envrc (overrides global gitignore, which often blanket-ignores it)
!.envrc

# ===== IDE & Editor =====
.idea/
.windsurf/
.cursor/
*.swp
*.swo
*.code-workspace

# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== Vercel =====
.vercel

# ===== AI CLI Tools & Configs =====
.serena
.gemini/
.claude/settings.local.json
# Claude Code scheduler runtime lock (sessionId + pid) — written by
# ScheduleWakeup / scheduled tasks. Per-session, never committed.
.claude/scheduled_tasks.lock
# Generated by `bun run agents:compat`: POSIX symlink or Windows junction to
# the committed `.agents/skills` source. Never edit or commit this alias.
.claude/skills
# Git worktrees created by the agent harness (EnterWorktree) or by hand. A
# worktree under here is a separate branch's FULL checkout, never repo source:
# leaving it untracked invites `git add -A` to commit a duplicate tree, and
# `git clean -fd` to delete it and orphan the metadata in .git/worktrees/.
# Matches the .prettierignore entry that already calls it "not this tree".
.claude/worktrees/
.playwright-mcp
.backups/

# ===== MCP Configuration =====
# .mcp.json and opencode.jsonc are COMMITTED — they reference secrets via
# ${VAR} / {env:VAR} expansion. Real values live in .env (ignored above).
# Local per-developer overrides go in *.local.* files (ignored below).
.mcp.local.json
opencode.local.jsonc
# dbhub.toml is COMMITTED (committed; ${VAR} placeholders, no secrets) — part of                                                           
# the QA testing-MCP strategy, same convention as .mcp.json / opencode.jsonc above.                                                        
# Per-developer overrides go in dbhub.local.toml (ignored below).                                                                          
dbhub.local.toml 

# Planning / audit scaffolding (working notes, plan drafts, audit
# reports, session handoffs). Kept on local disk only — never pushed.
.scratch/

# Session-management state for long workflow skills (per
# .agents/skills/agentic-dev-core/references/session-management.md).
# Contains per-skill plan.md / progress.md and archived sessions.
# Local-only — canonical artifacts are committed under .context/.
.session/

# ===== Installer lock + state =====
# `.template/installer.lock.json` is TRACKED (small, immutable sentinel that
# pins the bootstrapped template — written once by the scaffolder / installer).
# `.template/installer.state.json` is GITIGNORED (per-dev runtime idempotency
# cache — tracks which `bun setup` steps already completed).
# `.template/claude-md.upstream.sha` is GITIGNORED (per-dev runtime marker —
# records the last upstream AGENTS.md (formerly CLAUDE.md) the updater advised about, so the merge
# nudge fires once per upstream change, not every `bun up`).
.template/installer.state.json
.template/claude-md.upstream.sha
# `.template/upstream-sha/` is the same idea generalized: one marker per entry
# of PROTECTED_WATCHLIST, written by the protected-file drift hook.
.template/upstream-sha/

# ===== Auto-generated AI prompts (single-use, written by bun run update) =====
/.agents/prompts/

# ===== Refcheck local config (per-dev tuning, not committed) =====
.refcheckrc.toml

# ===== Skill-creator eval workspaces (local iteration artifacts, never committed) =====
.agents/skills/*-workspace/

# ===== Force-track skills lockfile =====
# skills.lock.json is generated by `bunx skills add` in scaffolded projects to
# pin the exact community-skill versions installed. It MUST be committed so
# teams reproduce the same skill set. Defensive entry — nothing above currently
# matches it, but this guards against future blanket *.lock or skills.* rules.
!skills.lock.json
!**/skills.lock.json

# ===== PBI: Jira-backed cache (Jira is the source of truth) =====
# `.context/PBI/` mirrors Jira. `bun run context:hydrate` rebuilds it from
# scratch, so committing it only produces merge conflicts between sessions that
# re-synced at different times. Ignore the whole tree, then re-include the two
# things Jira does NOT own (README + templates).
#
# Git cannot re-include a file whose parent directory is excluded, so the tree
# is excluded with `/*` (contents, not the directory itself) and the keepers are
# negated right after. Story-level context.md / progress.md / evidence/ are
# deliberately [LOCAL] and NOT negated — they stay on local disk only.
.context/PBI/*
!.context/PBI/README.md
!.context/PBI/templates/
