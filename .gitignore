# ====================================
# UPEX Project Starter - .gitignore
# ====================================

# Dependencies
node_modules/

# ===== Build Artifacts =====
dist/
build/
.next/
*.tsbuildinfo
next-env.d.ts

# ===== Playwright Test Artifacts =====
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# ===== Auth Storage (Session State) =====
/.auth/

# ===== Allure Reports =====
/allure-results/
/allure-report/

# ===== Custom Reports =====
/reports/
*.json.bak

# ===== Debug Logs =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Environment =====
.env
.env.local
.env.*.local
.env.sentry-build-plugin
.envrc.local
.direnv/
# Force-track .envrc (overrides global gitignore, which often blanket-ignores it)
!.envrc

# ===== IDE & Editor =====
.idea/
.windsurf/
*.swp
*.swo
*.code-workspace

# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== Vercel =====
.vercel

# ===== AI CLI Tools & Configs =====
.serena
.gemini/
.claude/settings.local.json
.playwright-mcp
.backups/
.context/mcp/outputs
.scratch/

# ===== MCP Configuration =====
# .mcp.json and opencode.jsonc are COMMITTED — they reference secrets via
# ${VAR} / {env:VAR} expansion. Real values live in .env (ignored above).
# Local per-developer overrides go in *.local.* files (ignored below).
.mcp.local.json
opencode.local.jsonc
opencode.json
.mcp.catalog.json
*.catalog.json
.mcpservers.json
dbhub.toml

# ===== Installer state (local dev tracker, not project state) =====
.agents/install-state.json

# ===== Planning artifacts (local context only, not part of boilerplate) =====
.plans/

# ===== Auto-generated framework caches with timestamps =====
.context/_framework/testing-capabilities.json
