{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openapi": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ivotoby/openapi-mcp-server",
        "--tools",
        "dynamic"
      ],
      "environment": {
        "API_BASE_URL": "{{API_BASE_URL}}",
        "OPENAPI_SPEC_PATH": "{{OPENAPI_SPEC_URL}}",
        "API_HEADERS": "Authorization:Bearer {{API_BEARER_TOKEN}}"
      },
      "enabled": false
    },
    "sql": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bytebase/dbhub@latest",
        "--config",
        "dbhub.toml"
      ],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": false
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{POSTMAN_API_KEY}}"
      },
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/{{SENTRY_ORG}}/{{SENTRY_PROJECT}}",
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com/",
      "enabled": false
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "environment": {
        "JIRA_URL": "{{ATLASSIAN_URL}}",
        "JIRA_USERNAME": "{{ATLASSIAN_EMAIL}}",
        "JIRA_API_TOKEN": "{{ATLASSIAN_API_TOKEN}}"
      },
      "enabled": false
    },
    "nanobanana": {
      "type": "local",
      "command": [
        "uvx",
        "nanobanana-mcp-server@latest"
      ],
      "environment": {
        "GEMINI_API_KEY": "{{GEMINI_API_KEY}}"
      },
      "enabled": false
    },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "environment": {
        "SLACK_MCP_XOXP_TOKEN": "{{SLACK_MCP_XOXP_TOKEN}}",
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
        "SLACK_MCP_USERS_CACHE": "./.session/mcp/slack/",
        "SLACK_MCP_CHANNELS_CACHE": "./.session/mcp/slack/"
      },
      "enabled": false
    }
  }
}
